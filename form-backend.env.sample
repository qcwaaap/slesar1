# --- SMTP (и для PHP на хостинге, и для Python send_form_server.py) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your@yandex.ru
SMTP_PASSWORD=
# SMTP_TO=   # если не задано — письмо на SMTP_USER

# --- Next.js (локально без PHP) ---
# NEXT_PUBLIC_FORM_SUBMIT_URL=http://127.0.0.1:8787/send-email

# --- Python-сервер формы ---
# FORM_SERVER_HOST=127.0.0.1
# FORM_SERVER_PORT=8787

# ========== Деплой PHP (каталог public/php → на сервер как /php/) ==========
# 1. Соберите сайт: npm run build → папка out/ содержит out/php/send-email.php и PHPMailer.
# 2. Залейте на хостинг содержимое out/ в корень сайта (или в подкаталог, тогда путь к форме смените).
# 3. Убедитесь, что хостинг выполняет .php (Apache/nginx + php-fpm), а не отдаёт файл как текст.
# 4. Задайте на сервере переменные SMTP_USER, SMTP_PASSWORD (и при необходимости SMTP_HOST, SMTP_PORT, SMTP_TO):
#    - панель хостинга «переменные окружения», или
#    - в .htaccess для Apache: SetEnv SMTP_USER "...", SetEnv SMTP_PASSWORD "..."
#      (если хостинг разрешает SetEnv для PHP getenv).
# 5. Проверьте в браузере POST на https://ваш-домен/php/send-email.php с JSON телом — ответ должен быть JSON.

# ========== Деплой на REG.RU (статический out/) ==========
# Обязательно залить ВСЁ содержимое папки out/, включая каталог _next/ (с подчёркиванием).
# Если _next не загрузился, CSS/JS дадут 404 — сайт «ломается» (голый HTML без стилей).
# В FileZilla/WinSCP включите отображение скрытых/системных имён и проверьте, что на сервере есть:
#   https://ваш-домен/_next/static/chunks/*.css  → должен открываться (не 404).
# Корень домена = содержимое out/ в public_html (а не вложенная папка out без переноса файлов).
# Если сайт лежит в подпапке, задайте NEXT_PUBLIC_BASE_PATH=/имя_папки и пересоберите проект.
# Канонический URL и OG: перед сборкой задайте NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru
